{
  "productName": "Sightline",
  "version": "0.1.0",
  "identifier": "com.sightline.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sightline",
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true,
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "maximized": true,
        "additionalBrowserArgs": "--disable-features=ElasticOverscroll,OverscrollHistoryNavigation"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
