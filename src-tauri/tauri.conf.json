{
  "productName": "Sightline",
  "version": "0.1.0",
  "identifier": "com.sightline.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run prepare:bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sightline",
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true,
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "maximized": true,
        "additionalBrowserArgs": "--disable-features=ElasticOverscroll,OverscrollHistoryNavigation"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/sightline-bridge"
    ],
    "resources": [
      "resources/extension/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4QUNFRDE1QTNFRkU3RTMKUldUajUrK2pGZTJzV05nWjJ6MXVpbW9SSkV4SUlwallzWklDeE1HZDJIUkcyeTN0WGphYXh5akEK",
      "endpoints": [
        "https://github.com/Hosea174/sightline/releases/latest/download/latest.json"
      ]
    }
  }
}
